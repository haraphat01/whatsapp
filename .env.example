# ---- AI generation (required for /api/ai/generate) ----
# Set ONE of these. If DEEPSEEK_API_KEY is set it takes priority over OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Supabase (planned production backend — not required to run locally) ----
# ChatFrame currently persists projects to the browser's localStorage so the
# full app works without any database. These are wired for a future migration
# to Supabase-backed storage, auth, and file uploads (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Public app URL (used by the screenshot exporter to resolve the render page) ----
# Only needed in production if behind a proxy that doesn't set x-forwarded-host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
